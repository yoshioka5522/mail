<Window x:Class="Hayabumi.App.Views.AddressBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="アドレス帳" Width="760" Height="540" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <TabControl Margin="8">
        <TabItem Header="連絡先">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Left" Width="300" Margin="0,0,12,0">
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" TextChanged="OnFilterChanged" Margin="0,0,0,6" ToolTip="名前・アドレス・会社名で絞り込み" />
                    <CheckBox x:Name="SavedOnlyBox" DockPanel.Dock="Top" Content="登録した連絡先だけを表示" IsChecked="True" Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,0,6" />
                    <ListBox x:Name="ContactList" SelectionMode="Extended" DisplayMemberPath="Display" SelectionChanged="OnContactSelected" />
                </DockPanel>
                <StackPanel>
                    <TextBlock Text="メールアドレス" />
                    <TextBox x:Name="AddressBox" Margin="0,2,0,8" />
                    <TextBlock Text="名前" />
                    <TextBox x:Name="NameBox" Margin="0,2,0,8" />
                    <TextBlock Text="会社名・所属" />
                    <TextBox x:Name="CompanyBox" Margin="0,2,0,8" />
                    <TextBlock Text="メモ" />
                    <TextBox x:Name="NoteBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <WrapPanel>
                        <Button MinWidth="80" Content="新規" Click="OnNewContactClick" Margin="0,0,6,6" />
                        <Button MinWidth="80" Content="保存" Click="OnSaveContactClick" Margin="0,0,6,6" />
                        <Button MinWidth="80" Content="削除" Click="OnDeleteContactClick" Margin="0,0,6,6" />
                        <Button MinWidth="80" Content="メールを作成" Click="OnComposeClick" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </TabItem>
        <TabItem Header="グループ">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,12,0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Margin="0,0,8,0" MinWidth="80" Content="新規" Click="OnNewGroupClick" />
                        <Button Margin="0,0,8,0" MinWidth="80" Content="削除" Click="OnDeleteGroupClick" />
                    </StackPanel>
                    <ListBox x:Name="GroupList" DisplayMemberPath="Name" SelectionChanged="OnGroupSelected" />
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="グループ名（宛先の入力で、この名前を入力すると全員を追加できます）" TextWrapping="Wrap" />
                        <TextBox x:Name="GroupNameBox" Margin="0,2,0,8" />
                        <TextBlock Text="メンバー（登録した連絡先から選ぶ）" />
                    </StackPanel>
                    <Button MinWidth="80" DockPanel.Dock="Bottom" Content="保存" Click="OnSaveGroupClick" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <ListBox x:Name="MemberList" Margin="0,2,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Contact.Display}" IsChecked="{Binding IsMember}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
