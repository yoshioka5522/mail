<Window x:Class="Hayabumi.App.Views.UpdateTokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="更新用トークンの設定" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            配布元の GitHub リポジトリが非公開のため、自動更新には読み取り専用のトークンが必要です。
            GitHub の［Settings］→［Developer settings］→［Fine-grained tokens］で、
            このリポジトリだけを対象に「Contents: Read-only」の権限で作成してください。
        </TextBlock>
        <TextBlock Margin="0,0,0,12">
            <Hyperlink NavigateUri="https://github.com/settings/personal-access-tokens/new" RequestNavigate="OnRequestNavigate">トークンの作成ページを開く</Hyperlink>
        </TextBlock>
        <Label Content="トークン(_T)" Target="{Binding ElementName=TokenBox}" Padding="0,0,0,4" />
        <PasswordBox x:Name="TokenBox" Padding="4,3" />
        <TextBlock x:Name="StatusText" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" />
        <TextBlock Text="トークンは Windows の資格情報マネージャーに暗号化して保存されます。" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Margin="0,0,8,0" MinWidth="80" Content="削除" Click="OnClearClick" />
            <Button Margin="0,0,8,0" MinWidth="80" Content="保存" IsDefault="True" Click="OnSaveClick" />
            <Button MinWidth="80" Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
