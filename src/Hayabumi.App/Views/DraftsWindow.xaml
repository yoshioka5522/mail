<Window x:Class="Hayabumi.App.Views.DraftsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="下書き・送信待ちのメール" Width="640" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Margin="0,0,8,0" MinWidth="80" Content="開く" IsDefault="True" Click="OnOpenClick" />
            <Button Margin="0,0,8,0" MinWidth="80" x:Name="RetryButton" Content="再送" Click="OnRetryClick" />
            <Button Margin="0,0,8,0" MinWidth="80" Content="削除" Click="OnDeleteClick" />
            <Button MinWidth="80" Content="閉じる" IsCancel="True" Margin="0" />
        </StackPanel>
        <ListView x:Name="Items" MouseDoubleClick="OnOpenClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="状態" Width="110" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="宛先" Width="170" DisplayMemberBinding="{Binding To}" />
                    <GridViewColumn Header="件名" Width="220" DisplayMemberBinding="{Binding Subject}" />
                    <GridViewColumn Header="日時" Width="100" DisplayMemberBinding="{Binding Date}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
