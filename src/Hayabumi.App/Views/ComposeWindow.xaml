<Window x:Class="Hayabumi.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hayabumi.App.Views"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="新規メッセージ" Width="820" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{x:Static local:ComposeWindow.SendCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:ComposeWindow.SaveCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:ComposeWindow.SendCommand}" Executed="OnSendExecuted" />
        <CommandBinding Command="{x:Static local:ComposeWindow.SaveCommand}" Executed="OnSaveExecuted" />
    </Window.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SendButton" Click="OnSendClick" ToolTip="送信 (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE724;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="送信" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Click="OnAttachClick" ToolTip="ファイルを添付（ドラッグ＆ドロップでも添付できます）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE723;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="添付" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveClick" ToolTip="下書きに保存 (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="下書き保存" />
                    </StackPanel>
                </Button>
                <Button Click="OnDiscardClick" ToolTip="この下書きを破棄">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="破棄" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="差出人" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <ComboBox x:Name="AccountBox" Grid.Column="1" Margin="0,2" DisplayMemberPath="EmailAddress" />
            <ComboBox x:Name="CharsetBox" Grid.Column="2" Margin="6,2,0,2" Width="130" SelectedIndex="0" ToolTip="文字コード">
                <ComboBoxItem Content="UTF-8" />
                <ComboBoxItem Content="ISO-2022-JP" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="宛先" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <local:RecipientBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="CC" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <local:RecipientBox x:Name="CcBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" />
            <TextBlock Grid.Row="3" Text="BCC" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <local:RecipientBox x:Name="BccBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" />
            <TextBlock Grid.Row="4" Text="件名" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
            <TextBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" TextChanged="OnSubjectChanged" />
        </Grid>

        <ItemsControl x:Name="AttachmentList" DockPanel.Dock="Top" Margin="84,0,12,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE723;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" Margin="6,0" />
                            <Button Content="×" MinWidth="0" Padding="4,0" Margin="0" Click="OnRemoveAttachmentClick" Tag="{Binding Path}" ToolTip="添付を外す" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0,1,0,0" Padding="12,8"
                 FontSize="14" SpellCheck.IsEnabled="False" />
    </DockPanel>
</Window>
