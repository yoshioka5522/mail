<Window x:Class="Hayabumi.App.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アカウントの追加" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="メールアカウントの情報を入力してください。" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="メールアドレス(_E)" Target="{Binding ElementName=EmailBox}" />
            <TextBox x:Name="EmailBox" Grid.Column="1" Margin="0,2" LostFocus="OnEmailLostFocus" />
            <Label Grid.Row="1" Content="表示名(_N)" Target="{Binding ElementName=NameBox}" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
            <Label Grid.Row="2" Content="ユーザー名(_U)" Target="{Binding ElementName=UserBox}" />
            <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
            <Label Grid.Row="3" Content="パスワード(_P)" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,2" Padding="4,3" />
        </Grid>

        <TextBlock x:Name="PresetNote" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,8,0,0" Visibility="Collapsed" />

        <GroupBox Header="受信サーバー（IMAP）" Margin="0,12,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImapHostBox" Margin="0,0,6,0" ToolTip="サーバー名" />
                <TextBox x:Name="ImapPortBox" Grid.Column="1" Text="993" Margin="0,0,6,0" ToolTip="ポート" />
                <ComboBox x:Name="ImapSecurityBox" Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="SSL/TLS" />
                    <ComboBoxItem Content="STARTTLS" />
                    <ComboBoxItem Content="なし（非推奨）" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <GroupBox Header="送信サーバー（SMTP）" Margin="0,8,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SmtpHostBox" Margin="0,0,6,0" ToolTip="サーバー名" />
                <TextBox x:Name="SmtpPortBox" Grid.Column="1" Text="587" Margin="0,0,6,0" ToolTip="ポート" />
                <ComboBox x:Name="SmtpSecurityBox" Grid.Column="2" SelectedIndex="1">
                    <ComboBoxItem Content="SSL/TLS" />
                    <ComboBoxItem Content="STARTTLS" />
                    <ComboBoxItem Content="なし（非推奨）" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <TextBlock Text="※ この版は IMAP とパスワード認証（アプリ パスワードを含む）に対応しています。POP3 と OAuth（Gmail・Microsoft のサインイン）は次の版で対応します。"
                   TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,10,0,0" />

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C62828" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="8" Margin="0,0,12,0" Visibility="Collapsed" />
            <Button x:Name="OkButton" Content="接続を確認して追加" IsDefault="True" Click="OnOkClick" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
