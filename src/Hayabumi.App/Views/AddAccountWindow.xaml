<Window x:Class="Hayabumi.App.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="アカウントの追加" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Outlook.com・Microsoft 365 は、サインインで追加できます。" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8">
            「Google でサインイン」は、開発者が登録した利用者だけが使えます。それ以外の Gmail は、下の欄にメールアドレスと
            <Hyperlink NavigateUri="https://myaccount.google.com/apppasswords" RequestNavigate="OnRequestNavigate">アプリ パスワード</Hyperlink>
            （2 段階認証の設定が必要）を入力して追加してください。
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Margin="0,0,8,0" MinWidth="80" x:Name="GoogleButton" Content="Google でサインイン" Click="OnGoogleClick" Padding="14,6" />
            <Button Margin="0,0,8,0" MinWidth="80" x:Name="MicrosoftButton" Content="Microsoft でサインイン" Click="OnMicrosoftClick" Padding="14,6" />
        </StackPanel>
        <Separator Margin="0,8" />
        <TextBlock Text="そのほかのメール（プロバイダー、独自ドメインなど）は、情報を入力してください。" Margin="0,4,0,12" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="メールアドレス(_E)" Target="{Binding ElementName=EmailBox}" />
            <TextBox x:Name="EmailBox" Grid.Column="1" Margin="0,2" LostFocus="OnEmailLostFocus" />
            <Label Grid.Row="1" Content="表示名(_N)" Target="{Binding ElementName=NameBox}" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
            <Label Grid.Row="2" Content="ユーザー名(_U)" Target="{Binding ElementName=UserBox}" />
            <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
            <Label Grid.Row="3" Content="パスワード(_P)" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,2" Padding="4,3" />
        </Grid>

        <TextBlock x:Name="PresetNote" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,8,0,0" Visibility="Collapsed" />

        <GroupBox Header="受信サーバー" Margin="0,12,0,0" Padding="8">
            <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="ImapRadio" Content="IMAP（おすすめ。ほかの端末と既読やフォルダを共有）" IsChecked="True" Checked="OnProtocolChanged" Margin="0,0,16,0" />
                <RadioButton x:Name="Pop3Radio" Content="POP3" Checked="OnProtocolChanged" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImapHostBox" Margin="0,0,6,0" ToolTip="サーバー名" />
                <TextBox x:Name="ImapPortBox" Grid.Column="1" Text="993" Margin="0,0,6,0" ToolTip="ポート" />
                <ComboBox x:Name="ImapSecurityBox" Grid.Column="2" SelectedIndex="0">
                    <ComboBoxItem Content="SSL/TLS" />
                    <ComboBoxItem Content="STARTTLS" />
                    <ComboBoxItem Content="なし（非推奨）" />
                </ComboBox>
            </Grid>
            <TextBlock x:Name="Pop3Note" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0"
                       Text="POP3 では、受信したメールはこの PC に保存し、サーバーにも残します。この PC で完全に削除したメールは、サーバーからも削除します。" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="送信サーバー（SMTP）" Margin="0,8,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SmtpHostBox" Margin="0,0,6,0" ToolTip="サーバー名" />
                <TextBox x:Name="SmtpPortBox" Grid.Column="1" Text="587" Margin="0,0,6,0" ToolTip="ポート" />
                <ComboBox x:Name="SmtpSecurityBox" Grid.Column="2" SelectedIndex="1">
                    <ComboBoxItem Content="SSL/TLS" />
                    <ComboBoxItem Content="STARTTLS" />
                    <ComboBoxItem Content="なし（非推奨）" />
                </ComboBox>
            </Grid>
        </GroupBox>



        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C62828" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="8" Margin="0,0,12,0" Visibility="Collapsed" />
            <Button Margin="0,0,8,0" MinWidth="80" x:Name="OkButton" Content="接続を確認して追加" IsDefault="True" Click="OnOkClick" />
            <Button MinWidth="80" Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
