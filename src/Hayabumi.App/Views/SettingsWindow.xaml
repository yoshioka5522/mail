<Window x:Class="Hayabumi.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Title="設定" Width="680" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" IsDefault="True" Click="OnSaveClick" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
        <TabControl>
            <TabItem Header="全般">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="受信の間隔" Width="200" VerticalAlignment="Center" />
                        <TextBox x:Name="IntervalBox" Width="60" />
                        <TextBlock Text=" 分（IDLE に対応したサーバーでは、新着はすぐに届きます）" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="送信を取り消せる時間" Width="200" VerticalAlignment="Center" />
                        <TextBox x:Name="UndoBox" Width="60" />
                        <TextBlock Text=" 秒（0 にするとすぐ送信）" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="CloseToTrayBox" Content="ウィンドウを閉じても、タスクトレイで受信と通知を続ける" Margin="0,6" />
                    <CheckBox x:Name="StartWithWindowsBox" Content="Windows にサインインしたときに起動する（タスクトレイで起動）" Margin="0,6" />
                </StackPanel>
            </TabItem>
            <TabItem Header="アカウント">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,0,12,0">
                        <ListBox x:Name="AccountList" Height="320" DisplayMemberPath="EmailAddress" SelectionChanged="OnAccountSelected" />
                        <Button Content="アカウントを削除" Click="OnDeleteAccountClick" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="AccountPanel" IsEnabled="False">
                        <TextBlock Text="表示名（差出人の名前）" Margin="0,0,0,4" />
                        <TextBox x:Name="DisplayNameBox" />
                        <TextBlock Text="署名" Margin="0,10,0,4" />
                        <TextBox x:Name="SignatureBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="AuthText" Margin="0,10,0,4" />
                        <StackPanel x:Name="PasswordPanel" Orientation="Horizontal">
                            <PasswordBox x:Name="PasswordBox" Width="220" Padding="4,3" />
                            <TextBlock Text=" 変更する場合だけ入力" VerticalAlignment="Center" Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                        <Button x:Name="ReSignInButton" Content="もう一度サインイン" Click="OnReSignInClick" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock x:Name="ServerText" Margin="0,10,0,0" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="誤送信対策">
                <StackPanel Margin="16">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        送信前の確認画面では、社外の宛先を赤く表示し、一つずつ確認しないと送信できません。
                        自分のメールアドレスのドメインのほかに、社内として扱うドメインを 1 行に 1 つ入力してください（例: example.co.jp）。
                    </TextBlock>
                    <TextBox x:Name="DomainsBox" Height="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </TabItem>
            <TabItem Header="データ">
                <StackPanel Margin="16">
                    <TextBlock Text="データフォルダ（メール、アドレス帳、設定）" Margin="0,0,0,4" />
                    <TextBox x:Name="DataFolderBox" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="フォルダを開く" Click="OnOpenDataFolderClick" />
                        <Button Content="別の場所へ移す…" Click="OnMoveDataFolderClick" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource SubtleBrush}">
                        別の場所へ移すと、メールと設定をコピーしてから Hayabumi を再起動します。元のフォルダは残すので、
                        新しい場所で問題なく使えることを確かめてから削除してください。
                        OneDrive などの同期フォルダは、データが壊れるおそれがあるため選ばないでください（バックアップの保存先には使えます）。
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
